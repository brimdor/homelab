apiVersion: v1
kind: Pod
metadata:
  name: kube-vip
  namespace: kube-system
spec:
  containers:
    - name: kube-vip
      image: ghcr.io/kube-vip/kube-vip:v0.6.4
      args:
        - manager
      env:
        - name: address
          value: {{ control_plane_endpoint }}
        - name: vip_arp
          value: "true"
        - name: port
          value: "6443"
        - name: cp_enable
          value: "true"
        - name: vip_leaderelection
          value: "true"
        # kube-vip's manager defaults are lease 5s / renew 3s / retry 1s. A
        # single renew window where the local apiserver stalls for more than
        # renewDeadline makes renewal fail, and onStoppedLeading exits
        # fatally ("lost leadership, restarting kube-vip"). Widen the window
        # so transient control-plane latency no longer kills the leader,
        # while keeping LeaseDuration > RenewDeadline > RetryPeriod.
        - name: vip_leaseduration
          value: "30"
        - name: vip_renewdeadline
          value: "20"
        - name: vip_retryperiod
          value: "4"
      securityContext:
        capabilities:
          add:
            - NET_ADMIN
            - NET_RAW
      resources:
        requests:
          cpu: 50m
          memory: 32Mi
        limits:
          cpu: 200m
          memory: 64Mi
      volumeMounts:
        - mountPath: /etc/kubernetes/admin.conf
          name: kubeconfig
  hostAliases:
    - hostnames:
        - kubernetes
      ip: 127.0.0.1
  hostNetwork: true
  volumes:
    - hostPath:
        path: {{ k3s_kubeconfig_file }}
      name: kubeconfig
