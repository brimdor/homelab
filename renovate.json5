{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  // Look up cluster-pull images through the registry's trusted HTTPS endpoint.
  registryAliases: {
    '10.0.20.11:32309': 'registry.eaglepass.io',
  },
  packageRules: [
    {
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'all non-major dependencies',
      groupSlug: 'all-minor-patch',
      matchPackageNames: [
        '*',
      ],
    },
    {
      matchFileNames: ['archived/**'],
      enabled: false,
    },
  ],
}
