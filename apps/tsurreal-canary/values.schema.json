{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "stage",
    "hostname",
    "issuer",
    "tlsSecret",
    "image",
    "sourceCommit",
    "sourceTree",
    "storageClass",
    "storage",
    "privateSources",
    "identityImage"
  ],
  "properties": {
    "stage": {
      "enum": [
        "namespace",
        "foundation",
        "candidate"
      ]
    },
    "hostname": {
      "const": "tsurreal-canary.eaglepass.io"
    },
    "issuer": {
      "const": "letsencrypt-prod"
    },
    "tlsSecret": {
      "const": "tsurreal-canary-tls"
    },
    "image": {
      "type": "string"
    },
    "sourceCommit": {
      "type": "string"
    },
    "sourceTree": {
      "type": "string"
    },
    "storageClass": {
      "const": "standard-rwo"
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "recovery",
        "packages"
      ],
      "properties": {
        "state": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        },
        "recovery": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        },
        "packages": {
          "type": "string",
          "pattern": "^[1-9][0-9]*Gi$"
        }
      }
    },
    "privateSources": {
      "const": [
        "10.0.0.0/16"
      ]
    },
    "identityImage": {
      "const": "docker.io/library/python:3.13.18-alpine3.24@sha256:7984cf56ceaddebe4fefeb75d64000b9f45d8b77b11a09b24524da6cdc3af0c8"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "candidate"
          }
        }
      },
      "then": {
        "properties": {
          "image": {
            "pattern": "^10\\.0\\.20\\.11:32309/tsurreal/hq@sha256:[a-f0-9]{64}$"
          },
          "sourceCommit": {
            "pattern": "^[a-f0-9]{40}$"
          },
          "sourceTree": {
            "pattern": "^[a-f0-9]{40}$"
          }
        }
      }
    }
  ]
}
