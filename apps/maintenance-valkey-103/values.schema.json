{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "partition", "generation", "node"],
  "properties": {
    "image": {
      "type": "string",
      "enum": [
        "docker.io/bitnamilegacy/valkey-cluster@sha256:32869e769b7e554219f2ae527b85f4a4739574750beac63b895f5d09fc38f53b",
        "docker.io/valkey/valkey@sha256:0f62bfecc0b713dc2111af3ee307d5cd53c6877b7a112c6143c4de20f1325e4c"
      ]
    },
    "partition": {"type": "integer", "minimum": 0, "maximum": 6},
    "generation": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"},
    "node": {"type": "string", "enum": ["pikachu", "totodile"]}
  }
}
